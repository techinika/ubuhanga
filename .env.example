# .env.local
# Copy this to .env.local and fill in your values.
# Never commit this file to version control.

# ─── Firebase Client SDK (browser-safe, PUBLIC_ prefix) ───
# Used in NewsletterForm.astro for client-side Firestore writes
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server-only, no PUBLIC_ prefix) ──
# Used in src/lib/firestore.ts for SSR data fetching
# Download your service account JSON from Firebase Console:
# Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
