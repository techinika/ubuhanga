---
// src/components/CommentSection.astro
// Client-side comment section for a single video page

interface Props {
  videoId: string;
}

const { videoId } = Astro.props;
---

<div class="comment-section" id="comment-section" data-video-id={videoId}>
  <h2 class="comment-section__heading">
    Comments
    <span class="comment-section__count" id="comment-count">0</span>
  </h2>

  <form class="comment-form" id="comment-form">
    <div class="comment-form__row">
      <input
        type="text"
        id="comment-name"
        class="comment-form__input comment-form__input--half"
        placeholder="Your name"
        required
        autocomplete="name"
        maxlength={60}
      />
    </div>
    <div class="comment-form__row">
      <textarea
        id="comment-text"
        class="comment-form__textarea"
        placeholder="Share your thoughts..."
        required
        maxlength={1000}
        rows={3}
      ></textarea>
    </div>
    <div class="comment-form__row comment-form__actions">
      <button type="submit" class="comment-form__btn" id="comment-submit">
        Post comment
      </button>
      <span class="comment-form__hint">Be kind and respectful</span>
    </div>
    <p class="comment-form__error" id="comment-error" hidden></p>
  </form>

  <div class="comment-section__list" id="comment-list">
    <p class="comment-section__loading" id="comment-loading">Loading comments...</p>
  </div>
</div>

<script>
  import {
    getFirebaseDB,
    collection,
    addDoc,
    getDocs,
    query,
    orderBy,
    doc,
    getDoc,
    serverTimestamp,
  } from '../lib/firebase-client';

  const section = document.getElementById('comment-section') as HTMLDivElement;
  const videoId = section?.dataset.videoId;
  if (!section || !videoId) throw new Error('Missing video ID');

  const form = document.getElementById('comment-form') as HTMLFormElement;
  const nameInput = document.getElementById('comment-name') as HTMLInputElement;
  const textInput = document.getElementById('comment-text') as HTMLTextAreaElement;
  const submitBtn = document.getElementById('comment-submit') as HTMLButtonElement;
  const errorEl = document.getElementById('comment-error') as HTMLParagraphElement;
  const listEl = document.getElementById('comment-list') as HTMLDivElement;
  const loadingEl = document.getElementById('comment-loading') as HTMLParagraphElement;
  const countEl = document.getElementById('comment-count') as HTMLSpanElement;

  const db = getFirebaseDB();
  const commentsRef = collection(db, 'comments');

  async function loadComments() {
    try {
      const q = query(
        collection(db, 'comments'),
        orderBy('createdAt', 'desc')
      );
      const snap = await getDocs(q);
      const allComments = snap.docs
        .map((d) => ({ id: d.id, ...d.data() } as any))
        .filter((c) => c.videoId === videoId);

      loadingEl.hidden = true;
      countEl.textContent = String(allComments.length);

      if (allComments.length === 0) {
        listEl.innerHTML = '<p class="comment-section__empty">No comments yet. Be the first!</p>';
        return;
      }

      listEl.innerHTML = allComments
        .map(
          (c) => `
        <div class="comment">
          <div class="comment__avatar" aria-hidden="true">${c.name?.charAt(0)?.toUpperCase() || '?'}</div>
          <div class="comment__body">
            <div class="comment__meta">
              <span class="comment__name">${escapeHtml(c.name || 'Anonymous')}</span>
              <span class="comment__dot">·</span>
              <time class="comment__date">${formatDate(c.createdAt)}</time>
            </div>
            <p class="comment__text">${escapeHtml(c.text || '')}</p>
          </div>
        </div>
      `
        )
        .join('');
    } catch {
      loadingEl.textContent = 'Could not load comments.';
    }
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function formatDate(ts: any): string {
    if (!ts) return 'just now';
    const date = ts.toDate ? ts.toDate() : new Date(ts);
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins}m ago`;
    const hours = Math.floor(mins / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    if (days < 7) return `${days}d ago`;
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    const name = nameInput.value.trim();
    const text = textInput.value.trim();
    if (!name || !text) return;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Posting...';

    try {
      await addDoc(commentsRef, {
        videoId,
        name,
        text,
        createdAt: serverTimestamp(),
      });
      nameInput.value = '';
      textInput.value = '';
      await loadComments();
    } catch (err) {
      errorEl.textContent = 'Failed to post comment. Try again.';
      errorEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Post comment';
    }
  });

  loadComments();
</script>

<style>
.comment-section {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
}

.comment-section__heading {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.comment-section__count {
  font-family: var(--font-body);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--color-text-muted);
  background: var(--color-surface-warm);
  padding: 0.1rem 0.55rem;
  border-radius: var(--radius-full);
}

/* Form */
.comment-form {
  margin-bottom: 2rem;
}

.comment-form__row {
  margin-bottom: 0.75rem;
}

.comment-form__input,
.comment-form__textarea {
  width: 100%;
  padding: 0.7rem 1rem;
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--color-text-primary);
  background: var(--color-bg);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-md);
  outline: none;
  transition: border-color var(--transition-fast);
  resize: vertical;
}

.comment-form__input:focus,
.comment-form__textarea:focus {
  border-color: var(--color-amber-500);
}

.comment-form__input--half {
  max-width: 320px;
}

.comment-form__textarea {
  min-height: 80px;
}

.comment-form__actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.comment-form__btn {
  padding: 0.6rem 1.4rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: #fff;
  background: var(--color-amber-600);
  border: none;
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: background var(--transition-fast);
}

.comment-form__btn:hover { background: var(--color-amber-700); }
.comment-form__btn:disabled { opacity: 0.6; cursor: not-allowed; }

.comment-form__hint {
  font-size: 0.8rem;
  color: var(--color-text-muted);
}

.comment-form__error {
  font-size: 0.85rem;
  color: var(--color-amber-700);
  background: var(--color-amber-50);
  padding: 0.5rem 0.875rem;
  border-radius: var(--radius-md);
  margin-top: 0.5rem;
}

/* List */
.comment-section__list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.comment-section__loading,
.comment-section__empty {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  padding: 1rem 0;
}

.comment {
  display: flex;
  gap: 0.875rem;
  padding: 1rem 0;
  border-bottom: 1px solid var(--color-border);
}

.comment:last-child { border-bottom: none; }

.comment__avatar {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--color-amber-100);
  color: var(--color-amber-700);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: 700;
}

.comment__body {
  flex: 1;
  min-width: 0;
}

.comment__meta {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  margin-bottom: 0.3rem;
}

.comment__name {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--color-text-primary);
}

.comment__dot { opacity: 0.4; color: var(--color-text-muted); font-size: 0.8rem; }

.comment__date {
  font-size: 0.8rem;
  color: var(--color-text-muted);
}

.comment__text {
  font-size: 0.92rem;
  line-height: 1.6;
  color: var(--color-text-secondary);
  word-wrap: break-word;
}

@media (prefers-color-scheme: dark) {
  .comment__avatar {
    background: rgba(180, 83, 9, 0.25);
    color: var(--color-amber-300);
  }

  .comment-form__error {
    background: rgba(180, 83, 9, 0.15);
    color: var(--color-amber-300);
  }
}
</style>
