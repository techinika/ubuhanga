---
// src/components/PlaylistCard.astro

interface Playlist {
  id: string;
  title: string;
  description: string;
  videoCount: number;
  thumbnail: string;
  slug: string;
  tags: string[];
}

interface Props { playlist: Playlist; }
const { playlist } = Astro.props;
---

<article class="playlist-card" role="listitem">
  <a href={`/playlists/${playlist.slug}`} class="playlist-card__thumb-link" aria-label={`Open playlist: ${playlist.title}`} tabindex="-1">
    <div class="playlist-card__thumb">
      <img
        src={playlist.thumbnail}
        alt={`Thumbnail for playlist "${playlist.title}"`}
        loading="lazy"
        decoding="async"
        width="480"
        height="270"
      />
      <div class="playlist-card__count" aria-label={`${playlist.videoCount} videos in this playlist`}>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 3h10M2 7h7M2 11h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        {playlist.videoCount} videos
      </div>
    </div>
  </a>

  <div class="playlist-card__body">
    <h3 class="playlist-card__title">
      <a href={`/playlists/${playlist.slug}`} class="playlist-card__title-link">
        {playlist.title}
      </a>
    </h3>

    <p class="playlist-card__desc">{playlist.description}</p>

    <div class="playlist-card__tags" aria-label="Topics covered">
      {playlist.tags.map((tag) => (
        <span class="playlist-card__tag">{tag}</span>
      ))}
    </div>

    <a href={`/playlists/${playlist.slug}`} class="playlist-card__cta" aria-label={`Start ${playlist.title} playlist`}>
      Start learning
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</article>

<style>
.playlist-card {
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: box-shadow var(--transition-base), transform var(--transition-base);
}

.playlist-card:hover {
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-2px);
}

/* Thumbnail */
.playlist-card__thumb-link { display: block; text-decoration: none; }

.playlist-card__thumb {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--color-neutral-100);
}

.playlist-card__thumb::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.45));
}

.playlist-card__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-slow);
}

.playlist-card:hover .playlist-card__thumb img {
  transform: scale(1.04);
}

.playlist-card__count {
  position: absolute;
  bottom: 10px;
  left: 10px;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  background: rgba(0,0,0,0.72);
  color: #fff;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-full);
}

/* Body */
.playlist-card__body {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  padding: 1.1rem 1.2rem 1.3rem;
  flex: 1;
}

.playlist-card__title {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.015em;
}

.playlist-card__title-link {
  color: var(--color-text-primary);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.playlist-card__title-link:hover { color: var(--color-amber-700); }

.playlist-card__desc {
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.playlist-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.1rem;
}

.playlist-card__tag {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-surface-warm);
  border: 1px solid var(--color-border);
  padding: 0.2rem 0.55rem;
  border-radius: var(--radius-full);
}

.playlist-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-amber-700);
  text-decoration: none;
  margin-top: auto;
  padding-top: 0.5rem;
  transition: gap var(--transition-fast);
}

.playlist-card__cta:hover { gap: 0.7rem; }

@media (prefers-color-scheme: dark) {
  .playlist-card__cta { color: var(--color-amber-400); }
}
</style>