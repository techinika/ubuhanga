---
// src/components/EmptyState.astro
// Reusable empty state for sections with no content

interface Props {
  title?: string;
  message?: string;
  icon?: 'folder' | 'search' | 'comment' | 'playlist';
  actionHref?: string;
  actionLabel?: string;
}

const { title = 'No content yet', message = 'Nothing to show here right now.', icon = 'folder', actionHref, actionLabel } = Astro.props;

const icons: Record<string, string> = {
  folder: '<path d="M3 4.5v11a1.5 1.5 0 001.5 1.5h11a1.5 1.5 0 001.5-1.5V7a1.5 1.5 0 00-1.5-1.5h-5l-2-2H4.5A1.5 1.5 0 003 4.5z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
  search: '<circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M14.5 14.5l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  comment: '<path d="M3 11a8 8 0 118 8H4l-1 3 3-1a8 8 0 01-3-10z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
  playlist: '<path d="M3 4h14M3 9h14M3 14h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
};
---

<div class="empty-state">
  <svg class="empty-state__icon" width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    {icons[icon]}
  </svg>
  <h3 class="empty-state__title">{title}</h3>
  <p class="empty-state__message">{message}</p>
  {actionHref && actionLabel && (
    <a href={actionHref} class="btn btn--ghost empty-state__action">{actionLabel}</a>
  )}
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-warm);
  }

  .empty-state__icon {
    color: var(--color-text-muted);
    opacity: 0.5;
    margin-bottom: 1.25rem;
  }

  .empty-state__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.4rem;
  }

  .empty-state__message {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    max-width: 30ch;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .empty-state__action {
    margin-top: 0.75rem;
  }
</style>
