---
// src/layouts/BaseLayout.astro
// Shared page shell: SEO head, nav, footer
import '../styles/globals.css';
// Global styles are imported via JS in the frontmatter

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  articlePublishedTime?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.svg',
  canonicalURL = Astro.url.href,
  articlePublishedTime,
  noIndex = false,
} = Astro.props;

const siteName = 'Ubuhanga';
const siteURL  = 'https://ubuhanga.techinika.com';
---

<!doctype html>
<html lang="rw" dir="ltr" data-theme>
<head>
  <script is:inline>
    (function() {
      var t = localStorage.getItem('ubuhanga-theme');
      if (t === 'dark' || t === 'light') {
        document.documentElement.setAttribute('data-theme', t);
      }
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type"        content={articlePublishedTime ? 'article' : 'website'} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={`${siteURL}${ogImage}`} />
  <meta property="og:site_name"   content={siteName} />
  <meta property="og:locale"      content="rw_RW" />
  {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
  {articlePublishedTime && <meta property="article:author" content="Ubuhanga" />}
  {articlePublishedTime && <meta property="article:section" content="Technology" />}

  <!-- Twitter / X -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={`${siteURL}${ogImage}`} />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon"    href="/apple-touch-icon.png" />

  <!-- RSS + Sitemap -->
  <link rel="alternate" type="application/rss+xml" title="Ubuhanga RSS Feed" href="/rss.xml" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

  <!-- hreflang -->
  <link rel="alternate" href={canonicalURL} hreflang="rw" />
  <link rel="alternate" href={canonicalURL} hreflang="x-default" />

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.youtube-nocookie.com" />

  <!-- Google AdSense — Auto Ads -->
  <script
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_ID}`}
    crossorigin="anonymous"
  />

  <!-- Structured Data — Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": siteName,
    "url": siteURL,
    "logo": `${siteURL}/favicon.svg`,
    "sameAs": [
      "https://youtube.com/@ubuhanga",
      "https://techinika.co.rw",
    ],
  })} />

  <!-- Structured Data — WebSite Sitelinks -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": siteName,
    "url": siteURL,
    "description": "A curated archive of programming and software development tutorials.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${siteURL}/search?q={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- Fonts -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lexend:wght@400;500;600;700;800&display=swap" as="style" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lexend:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lexend:wght@400;500;600;700;800&display=swap" /></noscript>
</head>

<body>

  <!-- ── Skip link (a11y) ─────────────────────────────── -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- ── Navigation ───────────────────────────────────── -->
  <header class="site-nav" role="banner">
    <div class="container site-nav__inner">

      <!-- Logo -->
      <a href="/" class="site-nav__logo" aria-label="Ubuhanga home">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect width="28" height="28" rx="7" fill="#B45309"/>
          <path d="M7 20V10.5L14 7l7 3.5V20" stroke="#FDE68A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M11 20v-6h6v6" stroke="#FDE68A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="14" cy="10" r="1.2" fill="#FBBF24"/>
        </svg>
        <span class="site-nav__logo-text">ubuhanga</span>
      </a>

      <!-- Desktop links -->
      <nav class="site-nav__links" aria-label="Main navigation">
        <a href="/videos"    class="site-nav__link">Videos</a>
        <a href="/playlists" class="site-nav__link">Playlists</a>
        <a href="/about"     class="site-nav__link">About</a>
      </nav>

      <!-- Right actions -->
      <div class="site-nav__actions">
        <a href="/search" class="site-nav__icon-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="https://agaseke.me/techinika" target="_blank" rel="noopener noreferrer"
           class="btn site-nav__support" aria-label="Support our work">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2S4 5 4 8a4 4 0 008 0c0-3-4-6-4-6z" stroke="currentColor" stroke-width="1.4" fill="none"/>
            <circle cx="8" cy="8" r="1.2" fill="currentColor"/>
          </svg>
          Support
        </a>
        <a href="https://youtube.com/@ubuhanga" target="_blank" rel="noopener noreferrer"
           class="btn btn--primary site-nav__cta" aria-label="Visit our YouTube channel">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M14.5 4.5S14.3 3.3 13.7 2.7C12.9 1.9 12 1.9 11.6 1.8 9.7 1.7 7 1.7 7 1.7S4.3 1.7 2.4 1.8C2 1.9 1.1 1.9.3 2.7c-.6.6-.8 1.8-.8 1.8S-.7 5.8-.7 7.1v1.2c0 1.3.2 2.6.2 2.6s.2 1.2.8 1.8c.8.8 1.9.8 2.3.8C3.9 13.7 7 13.7 7 13.7s2.7 0 4.6-.2c.4-.1 1.3-.1 2.1-.9.6-.6.8-1.8.8-1.8s.2-1.3.2-2.6V7.1C15.7 5.8 14.5 4.5 14.5 4.5zM5.8 10V5.5l4.4 2.3L5.8 10z" fill="currentColor"/>
          </svg>
          YouTube
        </a>

        <!-- Mobile hamburger -->
        <button class="site-nav__hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" id="hamburger-btn">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div class="mobile-menu" id="mobile-menu" aria-hidden="true" role="navigation" aria-label="Mobile menu">
      <nav class="mobile-menu__links">
        <a href="/videos"    class="mobile-menu__link">Videos</a>
        <a href="/playlists" class="mobile-menu__link">Playlists</a>
        <a href="/about"     class="mobile-menu__link">About</a>
        <a href="/search"    class="mobile-menu__link">Search</a>
        <a href="https://agaseke.me/techinika" target="_blank" rel="noopener" class="mobile-menu__link">Support</a>
      </nav>
    </div>
  </header>

  <!-- ── Main Content ──────────────────────────────────── -->
  <main id="main-content">
    <slot />
  </main>

  <!-- ── Footer ───────────────────────────────────────── -->
  <footer class="site-footer" role="contentinfo">
    <div class="container site-footer__inner">

      <div class="site-footer__brand">
        <a href="/" class="site-nav__logo" aria-label="Ubuhanga home">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect width="28" height="28" rx="7" fill="#B45309"/>
            <path d="M7 20V10.5L14 7l7 3.5V20" stroke="#FDE68A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M11 20v-6h6v6" stroke="#FDE68A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="14" cy="10" r="1.2" fill="#FBBF24"/>
          </svg>
          <span class="site-nav__logo-text">ubuhanga</span>
        </a>
        <p class="site-footer__tagline">
          Free programming tutorials, always available.
        </p>
      </div>

      <nav class="site-footer__nav" aria-label="Footer navigation">
        <div class="site-footer__nav-col">
          <p class="site-footer__nav-title">Content</p>
          <a href="/videos"    class="site-footer__nav-link">All Videos</a>
          <a href="/playlists" class="site-footer__nav-link">Playlists</a>
          <a href="/search"    class="site-footer__nav-link">Search</a>
        </div>
        <div class="site-footer__nav-col">
          <p class="site-footer__nav-title">More</p>
          <a href="/about"                                       class="site-footer__nav-link">About</a>
          <a href="/admin"                                       class="site-footer__nav-link">Admin</a>
          <a href="https://agaseke.me/techinika" target="_blank" rel="noopener" class="site-footer__nav-link">Support ↗</a>
          <a href="https://youtube.com/@ubuhanga" target="_blank" rel="noopener" class="site-footer__nav-link">YouTube ↗</a>
        </div>
      </nav>
    </div>

    <div class="container site-footer__bottom">
      <p class="site-footer__copy">
        &copy; {new Date().getFullYear()} Ubuhanga. All rights reserved.
      </p>
      <div class="site-footer__bottom-right">
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
          <svg class="theme-toggle__icon theme-toggle__icon--sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.3"/>
            <path d="M8 1v1.5M8 13.5V15M3.5 3.5l1 1M11.5 11.5l1 1M1 8h1.5M13.5 8H15M3.5 12.5l1-1M11.5 4.5l1-1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          <svg class="theme-toggle__icon theme-toggle__icon--moon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13.5 9.5A6 6 0 016.5 2.5 6 6 0 1013.5 9.5z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <p class="site-footer__credit">
          A product of <a href="https://techinika.co.rw" target="_blank" rel="noopener">Techinika</a>
        </p>
      </div>
    </div>
  </footer>

  <!-- Theme toggle script -->
  <script>
    const themeBtn = document.getElementById('theme-toggle');
    const html = document.documentElement;
    function getPreferredTheme() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    function getCurrentTheme() {
      return html.getAttribute('data-theme') || getPreferredTheme();
    }
    function setTheme(t) {
      html.setAttribute('data-theme', t);
      localStorage.setItem('ubuhanga-theme', t);
    }
    themeBtn?.addEventListener('click', () => {
      const next = getCurrentTheme() === 'dark' ? 'light' : 'dark';
      setTheme(next);
    });
  </script>

  <!-- Mobile menu toggle script -->
  <script>
    const btn  = document.getElementById('hamburger-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      function closeMenu() {
        btn.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
        menu.classList.remove('is-open');
        document.body.classList.remove('menu-open');
        btn.focus();
      }

      function openMenu() {
        btn.setAttribute('aria-expanded', 'true');
        menu.setAttribute('aria-hidden', 'false');
        menu.classList.add('is-open');
        document.body.classList.add('menu-open');
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }

      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        open ? closeMenu() : openMenu();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const open = btn.getAttribute('aria-expanded') === 'true';
          if (open) closeMenu();
        }
      });
    }
  </script>

</body>
</html>

<style is:global>
/* ─── Skip link ──────────────────────────────────────── */
.skip-link {
  position: absolute;
  top: -100%;
  left: 1rem;
  z-index: 9999;
  background: var(--color-amber-600);
  color: #fff;
  padding: 0.5rem 1rem;
  border-radius: var(--radius-md);
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
  transition: top var(--transition-fast);
}
.skip-link:focus { top: 1rem; }

/* ─── Site Nav ───────────────────────────────────────── */
.site-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  height: var(--nav-height);
  background: rgba(255,255,255,0.88);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-border);
}

@media (prefers-color-scheme: dark) {
  .site-nav { background: rgba(22,20,16,0.88); }
}

.site-nav__inner {
  display: flex;
  align-items: center;
  height: 100%;
  gap: 2rem;
}

.site-nav__logo {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  text-decoration: none;
  flex-shrink: 0;
}

.site-nav__logo-text {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: -0.02em;
}

.site-nav__links {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  margin-left: 1rem;
}

.site-nav__link {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--color-text-secondary);
  text-decoration: none;
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius-full);
  transition: background var(--transition-fast), color var(--transition-fast);
}

.site-nav__link:hover {
  color: var(--color-text-primary);
  background: var(--color-surface-warm);
}

.site-nav__link[aria-current="page"] {
  color: var(--color-amber-700);
  background: var(--color-amber-100);
}

.site-nav__actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-left: auto;
}

.site-nav__icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  text-decoration: none;
  transition: background var(--transition-fast), color var(--transition-fast);
}
.site-nav__icon-btn:hover {
  background: var(--color-surface-warm);
  color: var(--color-text-primary);
}

.site-nav__cta { font-size: 0.85rem; padding: 0.6rem 1.1rem; }

.site-nav__support {
  font-size: 0.82rem;
  padding: 0.5rem 1rem;
  color: var(--color-text-secondary);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-full);
  text-decoration: none;
  transition: background var(--transition-fast), color var(--transition-fast);
  white-space: nowrap;
}
.site-nav__support:hover {
  background: var(--color-surface-warm);
  color: var(--color-text-primary);
}

.site-nav__hamburger {
  display: none;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text-primary);
  border-radius: var(--radius-md);
}
.site-nav__hamburger:hover { background: var(--color-surface-warm); }

/* Mobile menu */
.mobile-menu {
  display: none;
  position: fixed;
  inset: var(--nav-height) 0 0 0;
  background: var(--color-bg);
  padding: 1.5rem;
  border-top: 1px solid var(--color-border);
  transform: translateY(-8px);
  opacity: 0;
  transition: transform var(--transition-base), opacity var(--transition-base);
}
.mobile-menu.is-open {
  opacity: 1;
  transform: translateY(0);
}

.mobile-menu__links {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.mobile-menu__link {
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--color-text-primary);
  text-decoration: none;
  padding: 0.75rem 0.5rem;
  border-bottom: 1px solid var(--color-border);
}

body.menu-open { overflow: hidden; }

/* ─── Footer ─────────────────────────────────────────── */
.site-footer {
  border-top: 1px solid var(--color-border);
  background: var(--color-surface-warm);
  padding: 4rem 0 2rem;
}

.site-footer__inner {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 3rem;
  margin-bottom: 3rem;
}

.site-footer__tagline {
  font-size: 0.875rem;
  color: var(--color-text-muted);
  margin-top: 0.75rem;
  max-width: 26ch;
}

.site-footer__nav {
  display: flex;
  gap: 3rem;
}

.site-footer__nav-col {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.site-footer__nav-title {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin-bottom: 0.25rem;
}

.site-footer__nav-link {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  text-decoration: none;
  transition: color var(--transition-fast);
}
.site-footer__nav-link:hover { color: var(--color-text-primary); }

.site-footer__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1.5rem;
  border-top: 1px solid var(--color-border);
  gap: 1rem;
  flex-wrap: wrap;
}

.site-footer__copy,
.site-footer__credit {
  font-size: 0.8rem;
  color: var(--color-text-muted);
}
.site-footer__credit a { color: var(--color-text-secondary); }
.site-footer__credit a:hover { color: var(--color-text-primary); }

.site-footer__bottom-right {
  display: flex;
  align-items: center;
  gap: 1rem;
}

/* Theme toggle */
.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  background: none;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  cursor: pointer;
  color: var(--color-text-muted);
  transition: color var(--transition-fast), border-color var(--transition-fast);
}
.theme-toggle:hover {
  color: var(--color-text-primary);
  border-color: var(--color-border-strong);
}

.theme-toggle__icon--sun { display: block; }
.theme-toggle__icon--moon { display: none; }

:root[data-theme="dark"] .theme-toggle__icon--sun { display: none; }
:root[data-theme="dark"] .theme-toggle__icon--moon { display: block; }

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .theme-toggle__icon--sun { display: none; }
  :root:not([data-theme="light"]) .theme-toggle__icon--moon { display: block; }
}

/* ─── Responsive nav ─────────────────────────────────── */
@media (max-width: 768px) {
  .site-nav__links    { display: none; }
  .site-nav__cta,
  .site-nav__support  { display: none; }
  .site-nav__hamburger { display: flex; }
  .mobile-menu      { display: block; }

  .site-footer__inner { grid-template-columns: 1fr; gap: 2rem; }
  .site-footer__nav   { gap: 2rem; }
}
</style>