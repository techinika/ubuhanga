---
// src/pages/videos/[slug].astro
// Single video page — YouTube embed + details + related

import BaseLayout from "@/layouts/BaseLayout.astro";
import VideoCard from "@/components/VideoCard.astro";
import CommentSection from "@/components/CommentSection.astro";
import GoogleAd from "@/components/GoogleAd.astro";
import EmptyState from "@/components/EmptyState.astro";
import { SITE_URL } from "@/lib/constants";
import { getVideoBySlug, getPlaylistById, getFeaturedVideos } from "@/lib/firestore";

const { slug } = Astro.params;
let video: import("@/lib/firestore").Video | null = null;
let playlist: import("@/lib/firestore").Playlist | null = null;
let related: import("@/lib/firestore").Video[] = [];
try {
  const result = await getVideoBySlug(slug!);
  video = result;
  playlist = result?.playlistId ? await getPlaylistById(result.playlistId) : null;
  related = result
    ? (await getFeaturedVideos(4, result.category)).filter((v) => v.slug !== result.slug).slice(0, 3)
    : [];
} catch {
  video = null;
  playlist = null;
  related = [];
}
---

<BaseLayout
  title={video ? `${video.title} — Ubuhanga` : "Video not found — Ubuhanga"}
  description={video?.description ?? "This video could not be found."}
  ogImage={video ? `https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg` : undefined}
  articlePublishedTime={video?.publishedAt}
  canonicalURL={video ? `${SITE_URL}/videos/${video.slug}` : undefined}
>
  {
    video ? (
      <>
<script is:inline
            type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "VideoObject",
            name: video.title,
            description: video.description,
            thumbnailUrl: `https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg`,
            embedUrl: `https://www.youtube-nocookie.com/embed/${video.youtubeId}`,
            uploadDate: video.publishedAt,
            duration: `PT${video.duration.replace(/^(\d+):(\d+)$/, (_, m, s) => `0H${String(m).padStart(2, "0")}M${String(s).padStart(2, "0")}S`).replace(/^(\d+):(\d+):(\d+)$/, (_, h, m, s) => `${String(h).padStart(2, "0")}H${String(m).padStart(2, "0")}M${String(s).padStart(2, "0")}S`)}`,
            author: { "@type": "Organization", name: "Ubuhanga" },
            contentUrl: `https://www.youtube-nocookie.com/embed/${video.youtubeId}`,
            interactionStatistic: {
              "@type": "InteractionCounter",
              interactionType: "WatchAction",
              userInteractionCount: video.views,
            },
          })}
        />
<script is:inline
            type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: [
              {
                "@type": "ListItem",
                position: 1,
                name: "Videos",
                item: `${SITE_URL}/videos`,
              },
              {
                "@type": "ListItem",
                position: 2,
                name: video.title,
                item: `${SITE_URL}/videos/${video.slug}`,
              },
            ],
          })}
        />
<script is:inline
            type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "VideoGallery",
            name: "More in " + video.category,
            description: "Related videos in the " + video.category + " category",
            url: `${SITE_URL}/videos`,
          })}
        />
        <article class="video-page" data-video-id={video.id}>
          <div class="container video-page__layout">
            <div class="video-page__main">
              <div class="video-page__player">
                <iframe
                  class="video-page__iframe"
                  src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}?rel=0`}
                  title={video.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="eager"
                />
              </div>

              <div class="video-page__info">
                <div class="video-page__meta-top">
                  <span class="video-page__category">{video.category}</span>
                  <span class="video-page__duration">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2" />
                      <path
                        d="M7 4v3.5l2.5 1.5"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                      />
                    </svg>
                    {video.duration}
                  </span>
                </div>

                <h1 class="video-page__title">{video.title}</h1>

                <div class="video-page__meta">
                  <span class="video-page__views">{video.views} views</span>
                  <span class="video-page__dot" aria-hidden="true">
                    ·
                  </span>
                  <time class="video-page__date" datetime={video.publishedAt}>
                    {new Date(video.publishedAt).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                </div>

                {playlist && (
                  <a href={`/playlists/${playlist.slug}`} class="video-page__playlist-link">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                      <rect
                        x="2"
                        y="3"
                        width="14"
                        height="12"
                        rx="2"
                        stroke="currentColor"
                        stroke-width="1.4"
                      />
                      <path d="M7 7l4 2-4 2V7z" fill="currentColor" />
                    </svg>
                    Part of <strong>{playlist.title}</strong>
                  </a>
                )}

                <div class="video-page__description">
                  <p>{video.description}</p>
                </div>

                {video.tags && video.tags.length > 0 && (
                  <div class="video-page__tags">
                    {video.tags.map((tag) => (
                      <span class="video-page__tag">{tag}</span>
                    ))}
                  </div>
                )}

                <CommentSection videoId={video.id} />
              </div>
            </div>

            <aside class="video-page__sidebar" aria-label="Related videos">
              <GoogleAd slot="VIDEO_SIDEBAR" format="rectangle" className="ad-sidebar" />
              {related.length > 0 ? (
                <div class="video-page__related">
                  <h2 class="video-page__related-title">More in {video.category}</h2>
                  <div class="video-page__related-grid">
                    {related.map((v) => (
                      <VideoCard video={v} />
                    ))}
                  </div>
                </div>
              ) : (
                <EmptyState title="No related videos" message="Check back later for more content." icon="folder" />
              )}
            </aside>
          </div>
        </article>
      </>
    ) : (
      <section class="not-found">
        <div class="container">
          <h1 class="not-found__title">Video not found</h1>
          <p class="not-found__text">
            The video you're looking for doesn't exist or has been removed.
          </p>
          <a href="/videos" class="btn btn--primary">
            Browse all videos
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  import { getFirebaseDB, doc, updateDoc, increment } from "@/lib/firebase-client";

  const videoIdEl = document.querySelector("[data-video-id]");
  const vidId = videoIdEl?.getAttribute("data-video-id");
  if (vidId) {
    try {
      const db = getFirebaseDB();
      const videoRef = doc(db, "videos", vidId);
      await updateDoc(videoRef, { views: increment(1) });
    } catch (e) {
      console.error("Failed to increment view count:", e);
    }
  }
</script>

<style>
  /* ─── Video Page ─────────────────────────────────────── */
  .video-page {
    padding: 2rem 0 5rem;
  }

  .video-page__layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    align-items: start;
  }

  /* Player */
  .video-page__player {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .video-page__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Info */
  .video-page__meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .video-page__category {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-amber-700);
    background: var(--color-amber-100);
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-full);
  }

  .video-page__duration {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .video-page__title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .video-page__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .video-page__dot {
    opacity: 0.4;
  }

  .video-page__playlist-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-amber-700);
    background: var(--color-amber-50);
    border: 1px solid var(--color-amber-200);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: background var(--transition-fast);
  }

  .video-page__playlist-link:hover {
    background: var(--color-amber-100);
  }

  .video-page__description {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    max-width: 70ch;
  }

  .video-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .video-page__tag {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-surface-warm);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  /* Sidebar */
  .video-page__sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
  }

  .video-page__related-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .video-page__related-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Not found */
  .not-found {
    text-align: center;
    padding: 6rem 0;
  }

  .not-found__title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .not-found__text {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .video-page__layout {
      grid-template-columns: 1fr;
    }

    .video-page__sidebar {
      position: static;
    }

    .video-page__related-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .video-page {
      padding: 1rem 0 3rem;
    }

    .video-page__player {
      border-radius: 0;
      margin-left: calc(-1 * var(--container-pad));
      margin-right: calc(-1 * var(--container-pad));
      width: calc(100% + 2 * var(--container-pad));
    }
  }

  @media (prefers-color-scheme: dark) {
    .video-page__category {
      background: rgba(180, 83, 9, 0.25);
      color: var(--color-amber-300);
    }

    .video-page__playlist-link {
      background: rgba(180, 83, 9, 0.12);
      border-color: rgba(180, 83, 9, 0.3);
      color: var(--color-amber-300);
    }

    .video-page__playlist-link:hover {
      background: rgba(180, 83, 9, 0.2);
    }
  }
</style>
