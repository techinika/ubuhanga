---
// src/pages/about.astro
// About Techinika — a venture studio and media house

import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Techinika — Venture Studio & Media House"
  description="Techinika is a venture studio and media house building tools that empower creators, educate learners, and tell stories of innovation across Africa."
>
  <section class="about-hero">
    <div class="container about-hero__inner">
      <div class="about-hero__text">
        <span class="about-hero__label">About</span>
        <h1 class="about-hero__title">
          Venture studio &<br />
          <em>media house</em>
        </h1>
        <p class="about-hero__subtitle">
          We build tools that empower creators, educate learners, and tell stories of innovation
          across Africa.
        </p>
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="container">
      <div class="about-content">
        <h2>What is Techinika?</h2>
        <p>
          Techinika is a venture studio and media house. We build software products that solve
          real problems in media, education, and the creative industry — with Africa as our home
          and our lens.
        </p>
        <p>
          We are not an education initiative. Education is one of the things we do, because it is
          one of the problems worth solving. But our mission is broader: to equip creators with
          better tools, to tell the stories of innovation across the continent, and to build the
          technological scaffolding that the next generation of African builders will stand on.
        </p>

        <h2>What we build</h2>
        <p>
          <strong>Ubuhanga</strong> — a free, open learning platform that teaches programming and
          tech skills in Kinyarwanda. No paywalls, no sign-ups. Just practical, real-world
          knowledge in the language you understand best. <a href="/">Start learning →</a>
        </p>
        <p>
          <strong>More coming.</strong> We are actively building products for media management,
          creator tools, and digital storytelling. If you are working on something at the
          intersection of technology and media in Africa,
          <a href="https://techinika.co.rw" target="_blank" rel="noopener">we should talk</a>.
        </p>

        <h2>Our approach</h2>
        <p>
          We build in the open. We ship fast. We design for the constraints and opportunities of
          the African market — unreliable infrastructure, mobile-first users, price-sensitive
          audiences, and a deep hunger for quality content in local languages.
        </p>
        <p>
          Every product we create must meet three criteria: it solves a genuine problem, it works
          where our users are, and it is built by people who understand the context.
        </p>

        <div class="about-actions">
          <a
            href="https://techinika.co.rw"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
          >
            Visit Techinika
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M3 7h8M8 4l3 3-3 3"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="/videos" class="btn btn--ghost">Browse free tutorials</a>
        </div>
      </div>
    </div>
  </section>

  <section class="about-values">
    <div class="container">
      <div class="about-values__grid">
        <div class="about-value">
          <div class="about-value__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 2L2 7l10 5 10-5-10-5z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
              <path
                d="M2 17l10 5 10-5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
              <path
                d="M2 12l10 5 10-5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="about-value__title">Africa-first</h3>
          <p class="about-value__desc">
            Every product we build is designed for African users, in their languages, on their
            terms.
          </p>
        </div>
        <div class="about-value">
          <div class="about-value__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 2v20M2 12h20"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
            </svg>
          </div>
          <h3 class="about-value__title">Open by default</h3>
          <p class="about-value__desc">
            We build in the open and share what we learn. Our tools are free where they can be.
          </p>
        </div>
        <div class="about-value">
          <div class="about-value__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"></circle>
              <path
                d="M4 22c0-4 3.6-8 8-8s8 4 8 8"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
            </svg>
          </div>
          <h3 class="about-value__title">Context-aware</h3>
          <p class="about-value__desc">
            Built by people who understand the constraints, opportunities, and culture of the
            markets we serve.
          </p>
        </div>
        <div class="about-value">
          <div class="about-value__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <rect
                x="3"
                y="3"
                width="18"
                height="18"
                rx="3"
                stroke="currentColor"
                stroke-width="1.5"></rect>
              <path d="M3 9h18" stroke="currentColor" stroke-width="1.5"></path>
              <path d="M9 21V9" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </div>
          <h3 class="about-value__title">Media & creative</h3>
          <p class="about-value__desc">
            Our focus is media, creative tools, and storytelling — the industries shaping
            Africa's narrative.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ──────────────────────────────────────────── */
  .about-hero {
    padding: 5rem 0 4rem;
    background: var(--color-surface-warm);
    border-bottom: 1px solid var(--color-border);
  }

  .about-hero__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-amber-700);
    margin-bottom: 1rem;
    display: inline-block;
  }

  .about-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .about-hero__title em {
    font-style: italic;
    color: var(--color-amber-600);
  }

  .about-hero__subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
  }

  /* ─── Content ──────────────────────────────────────── */
  .about-section {
    padding: 4rem 0 3rem;
  }

  .about-content {
    max-width: 680px;
  }

  .about-content h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .about-content h2:first-child {
    margin-top: 0;
  }

  .about-content p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }

  .about-content a {
    color: var(--color-amber-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about-actions {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  /* ─── Values ────────────────────────────────────────── */
  .about-values {
    padding: 3rem 0 4rem;
    background: var(--color-surface-warm);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2rem;
  }

  .about-value {
    padding: 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .about-value__icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-amber-100);
    color: var(--color-amber-700);
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
  }

  .about-value__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.4rem;
  }

  .about-value__desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ─── Techinika ────────────────────────────────────────── */
  .about-techinika {
    padding: 4rem 0 5rem;
  }

  .about-techinika__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .about-techinika__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .about-techinika__body {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    max-width: 55ch;
  }

  .about-techinika__body a {
    color: var(--color-amber-700);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (prefers-color-scheme: dark) {
    .about-value__icon {
      background: rgba(180, 83, 9, 0.25);
      color: var(--color-amber-300);
    }

    .about-content a,
    .about-techinika__body a {
      color: var(--color-amber-400);
    }
  }

  @media (max-width: 640px) {
    .about-hero {
      padding: 3rem 0 2.5rem;
    }
    .about-section {
      padding: 2.5rem 0 2rem;
    }
    .about-values {
      padding: 2rem 0 2.5rem;
    }
    .about-techinika {
      padding: 2.5rem 0 3rem;
    }

    .about-values__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
