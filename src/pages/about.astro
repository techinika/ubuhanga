---
// src/pages/about.astro
// About Ubuhanga — a Techinika product teaching tech skills in Kinyarwanda

import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Ubuhanga — Free Kinyarwanda Tech Tutorials"
  description="Ubuhanga is a free learning platform by Techinika, teaching programming and tech skills in Kinyarwanda. Learn React, Node.js, Python & more in your language."
>
  <section class="about-hero">
    <div class="container about-hero__inner">
      <div class="about-hero__text">
        <span class="about-hero__label">About</span>
        <h1 class="about-hero__title">
          Ubumenyi bw'ikoranabuhanga<br />
          <em>mu rurimi rwawe</em>
        </h1>
        <p class="about-hero__subtitle">Technology knowledge in your language.</p>
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="container">
      <div class="about-content">
        <h2>What is Ubuhanga?</h2>
        <p>
          Ubuhanga ni urubuga rw'uburezi rw'ubuntu rutanga amasomo y'ubumenyingiro mu ikoranabuhanga
          mu rurimi rw'Ikinyarwanda. Intego yacu ni ugufasha abavuga Ikinyarwanda kwiga tekinoloji,
          gukora porogaramu, no kubaka ubuhanga bw'ikoranabuhanga mu rurimi rwabo kavukire.
        </p>
        <p>
          Ubuhanga is a free, open learning platform that delivers tech tutorials in <strong
            >Kinyarwanda</strong
          >. Our mission is to bridge the language gap in tech education by creating high-quality
          content for Kinyarwanda speakers, taught in the language they understand best.
        </p>

        <h2>A product of Techinika</h2>
        <p>
          Ubuhanga is a product of <a href="https://techinika.co.rw" target="_blank" rel="noopener"
            >Techinika</a
          >, a Rwandan initiative dedicated to advancing technology education and digital skills
          development. Techinika works to make tech knowledge accessible to everyone in Rwanda and
          beyond.
        </p>

        <h2>Free, always</h2>
        <p>
          All content on Ubuhanga is completely free. No paywalls, no subscriptions, no sign-ups
          required. We believe that access to quality tech education should never be a barrier.
        </p>
        <p>
          If you find value in what we do, consider supporting us through a donation. Your
          contributions help us create more content, improve the platform, and reach more learners.
        </p>

        <div class="about-actions">
          <a
            href="https://agaseke.me/techinika"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M8 2S4 5 4 8a4 4 0 008 0c0-3-4-6-4-6z"
                stroke="currentColor"
                stroke-width="1.4"
                fill="none"></path>
              <circle cx="8" cy="8" r="1.2" fill="currentColor"></circle>
            </svg>
            Support our work
          </a>
          <a href="/videos" class="btn btn--ghost">Browse tutorials</a>
        </div>
      </div>
    </div>
  </section>

  <section class="about-values">
    <div class="container">
      <div class="about-values__grid">
        <div class="about-value">
          <div class="about-value__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 2L2 7l10 5 10-5-10-5z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
              <path
                d="M2 17l10 5 10-5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
              <path
                d="M2 12l10 5 10-5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="about-value__title">Kinyarwanda-first</h3>
          <p class="about-value__desc">
            All tutorials are created in Kinyarwanda, making tech education accessible to native
            speakers.
          </p>
        </div>
        <div class="about-value">
          <div class="about-value__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path
                d="M12 2v20M2 12h20"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
            </svg>
          </div>
          <h3 class="about-value__title">Always free</h3>
          <p class="about-value__desc">
            No paywalls, no subscriptions. Learning should be free for everyone.
          </p>
        </div>
        <div class="about-value">
          <div class="about-value__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"></circle>
              <path
                d="M4 22c0-4 3.6-8 8-8s8 4 8 8"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
            </svg>
          </div>
          <h3 class="about-value__title">Community-driven</h3>
          <p class="about-value__desc">Built by practitioners for the Rwandan tech community.</p>
        </div>
        <div class="about-value">
          <div class="about-value__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <rect
                x="3"
                y="3"
                width="18"
                height="18"
                rx="3"
                stroke="currentColor"
                stroke-width="1.5"></rect>
              <path d="M3 9h18" stroke="currentColor" stroke-width="1.5"></path>
              <path d="M9 21V9" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </div>
          <h3 class="about-value__title">Practical skills</h3>
          <p class="about-value__desc">
            Hands-on tutorials covering real-world tools and workflows developers actually use.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-techinika">
    <div class="container about-techinika__inner">
      <div class="about-techinika__text">
        <h2 class="about-techinika__title">About Techinika</h2>
        <p class="about-techinika__body">
          <a href="https://techinika.co.rw" target="_blank" rel="noopener">Techinika</a>
          is a Rwandan initiative focused on advancing technology education and digital skills development.
          Through platforms like Ubuhanga, Techinika aims to make tech knowledge accessible to Kinyarwanda
          speakers across Rwanda and the diaspora.
        </p>
      </div>
      <div class="about-techinika__action">
        <a href="https://techinika.co.rw" target="_blank" rel="noopener" class="btn btn--outline">
          Visit Techinika
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path
              d="M3 7h8M8 4l3 3-3 3"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ──────────────────────────────────────────── */
  .about-hero {
    padding: 5rem 0 4rem;
    background: var(--color-surface-warm);
    border-bottom: 1px solid var(--color-border);
  }

  .about-hero__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-amber-700);
    margin-bottom: 1rem;
    display: inline-block;
  }

  .about-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .about-hero__title em {
    font-style: italic;
    color: var(--color-amber-600);
  }

  .about-hero__subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
  }

  /* ─── Content ──────────────────────────────────────── */
  .about-section {
    padding: 4rem 0 3rem;
  }

  .about-content {
    max-width: 680px;
  }

  .about-content h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .about-content h2:first-child {
    margin-top: 0;
  }

  .about-content p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }

  .about-content a {
    color: var(--color-amber-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about-actions {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  /* ─── Values ────────────────────────────────────────── */
  .about-values {
    padding: 3rem 0 4rem;
    background: var(--color-surface-warm);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2rem;
  }

  .about-value {
    padding: 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .about-value__icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-amber-100);
    color: var(--color-amber-700);
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
  }

  .about-value__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.4rem;
  }

  .about-value__desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ─── Techinika ────────────────────────────────────────── */
  .about-techinika {
    padding: 4rem 0 5rem;
  }

  .about-techinika__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .about-techinika__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .about-techinika__body {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    max-width: 55ch;
  }

  .about-techinika__body a {
    color: var(--color-amber-700);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (prefers-color-scheme: dark) {
    .about-value__icon {
      background: rgba(180, 83, 9, 0.25);
      color: var(--color-amber-300);
    }

    .about-content a,
    .about-techinika__body a {
      color: var(--color-amber-400);
    }
  }

  @media (max-width: 640px) {
    .about-hero {
      padding: 3rem 0 2.5rem;
    }
    .about-section {
      padding: 2.5rem 0 2rem;
    }
    .about-values {
      padding: 2rem 0 2.5rem;
    }
    .about-techinika {
      padding: 2.5rem 0 3rem;
    }

    .about-values__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
