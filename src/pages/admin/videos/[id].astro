---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getDB } from "../../../lib/firestore";

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/videos");

const db = getDB();
const snap = await db.collection("videos").doc(id).get();

if (!snap.exists) {
  return Astro.redirect("/admin/videos");
}

const data = snap.data()!;
const publishedAt = data.publishedAt
  ? String(data.publishedAt).slice(0, 10)
  : "";

const catsSnap = await db.collection("categories").orderBy("name").get();
const categories = catsSnap.docs.map((d) => d.data().name as string);

const plSnap = await db.collection("playlists").orderBy("title").get();
const playlists = plSnap.docs.map((d) => ({ id: d.id, title: d.data().title }));
---

<AdminLayout title="Edit video — Admin — Ubuhanga" heading="Edit video">
  <form id="video-form" class="admin-form">
    <label class="admin-field">
      <span class="admin-field__label">Title</span>
      <input class="admin-field__input" name="title" value={data.title ?? ""} required />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Description</span>
      <textarea class="admin-field__textarea" name="description" rows="3">{data.description ?? ""}</textarea>
    </label>
    <label class="admin-field">
      <span class="admin-field__label">YouTube ID</span>
      <input class="admin-field__input" name="youtubeId" value={data.youtubeId ?? ""} required />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Thumbnail URL</span>
      <input class="admin-field__input" name="thumbnail" value={data.thumbnail ?? ""} />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Duration</span>
      <input class="admin-field__input" name="duration" value={data.duration ?? ""} required />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Category</span>
      <select class="admin-field__select" name="category" required>
        <option value="">— Select —</option>
        {categories.filter(c => c !== "All").map(c => (
          <option value={c} selected={data.category === c}>{c}</option>
        ))}
      </select>
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Published at</span>
      <input class="admin-field__input" name="publishedAt" type="date" value={publishedAt} required />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Slug</span>
      <input class="admin-field__input" name="slug" value={data.slug ?? ""} />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Playlist</span>
      <select class="admin-field__select" name="playlistId">
        <option value="">— None —</option>
        {playlists.map(p => (
          <option value={p.id} selected={data.playlistId === p.id}>{p.title}</option>
        ))}
      </select>
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Tags (comma-separated)</span>
      <input class="admin-field__input" name="tags"
        value={(Array.isArray(data.tags) ? data.tags : []).join(", ")} />
    </label>
    <div class="admin-form__actions">
      <button type="submit" class="admin-btn admin-btn--primary">Update</button>
      <a href="/admin/videos" class="admin-btn">Cancel</a>
    </div>
    <p class="admin-form__error" id="form-error" hidden></p>
  </form>
</AdminLayout>

<script>
  import { getFirebaseDB } from "../../../lib/firebase-client";
  import { getFirebaseAuth } from "../../../lib/firebase-client";
  import { onAuthStateChanged } from "firebase/auth";
  import { doc, updateDoc } from "firebase/firestore";

  const auth = getFirebaseAuth();
  const db = getFirebaseDB();

  onAuthStateChanged(auth, (user) => {
    if (!user) { window.location.href = "/admin"; return; }
  });

  const videoId = window.location.pathname.split("/").pop()!;

  document.getElementById("video-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const errEl = document.getElementById("form-error")!;
    errEl.hidden = true;
    const fd = new FormData(e.target as HTMLFormElement);
    const formData: Record<string, unknown> = {};
    fd.forEach((val, key) => { formData[key] = val; });

    if (!formData.youtubeId || !/^[a-zA-Z0-9_-]{11}$/.test(formData.youtubeId as string)) {
      errEl.textContent = "YouTube ID must be exactly 11 characters.";
      errEl.hidden = false;
      return;
    }
    if (!formData.duration || !/^\d{1,2}:\d{2}$/.test(formData.duration as string)) {
      errEl.textContent = "Duration must be in MM:SS format (e.g. 42:18).";
      errEl.hidden = false;
      return;
    }
    if (!formData.slug) {
      formData.slug = (formData.title as string).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
    }
    if (!formData.thumbnail) {
      formData.thumbnail = `https://img.youtube.com/vi/${formData.youtubeId}/maxresdefault.jpg`;
    }
    if (formData.tags) {
      formData.tags = (formData.tags as string).split(",").map((t: string) => t.trim()).filter(Boolean);
    } else {
      formData.tags = [];
    }

    try {
      await updateDoc(doc(db, "videos", videoId), formData);
      window.location.href = "/admin/videos";
    } catch (err) {
      errEl.textContent = err instanceof Error ? err.message : "Failed to save.";
      errEl.hidden = false;
    }
  });
</script>
