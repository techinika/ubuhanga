---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getDB } from "@/lib/firestore";

const db = getDB();
const snap = await db.collection("categories").orderBy("name").get();
const categories = snap.docs.map((d) => ({ id: d.id, name: d.data().name }));
---

<AdminLayout title="Categories — Admin — Ubuhanga" heading="Categories">
  <div class="admin-bar">
    <p class="admin-bar__title">All categories</p>
    <button id="category-add-btn" class="admin-btn admin-btn--primary">+ Add category</button>
  </div>

  {
    categories.length === 0 ? (
      <p class="admin-empty">No categories yet.</p>
    ) : (
      <div class="admin-category-list" id="categories-list">
        {categories.map((c) => (
          <div class="admin-category-item">
            <span>{c.name}</span>
            <button class="admin-btn-sm admin-btn-sm--danger" data-delete-category={c.id}>
              Delete
            </button>
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>

<script>
  import { getFirebaseDB, getFirebaseAuth } from "@/lib/firebase-client";
  import { onAuthStateChanged } from "firebase/auth";
  import { collection, addDoc, deleteDoc, doc } from "firebase/firestore";

  const auth = getFirebaseAuth();
  const db = getFirebaseDB();

  onAuthStateChanged(auth, (user) => {
    if (!user) {
      window.location.href = "/admin";
      return;
    }
    initPage();
  });

  function initPage() {
    document.querySelectorAll("[data-delete-category]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-delete-category")!;
        const name =
          btn.closest(".admin-category-item")?.querySelector("span")?.textContent?.trim() ||
          "this category";
        if (!confirm(`Delete category "${name}"?`)) return;
        (btn as HTMLButtonElement).disabled = true;
        try {
          await deleteDoc(doc(db, "categories", id));
          btn.closest(".admin-category-item")?.remove();
        } catch (e) {
          console.error("Failed to delete:", e);
          alert("Failed to delete.");
          (btn as HTMLButtonElement).disabled = false;
        }
      });
    });
  }

  document.getElementById("category-add-btn")?.addEventListener("click", async () => {
    const name = prompt("Category name:");
    if (!name?.trim()) return;
    if (name.trim().length > 50) {
      alert("Category name must be 50 characters or fewer.");
      return;
    }
    const existing = document.querySelectorAll(".admin-category-item span");
    for (const el of existing) {
      if (el.textContent?.toLowerCase() === name.trim().toLowerCase()) {
        alert("Category already exists.");
        return;
      }
    }
    const addBtn = document.getElementById("category-add-btn") as HTMLButtonElement;
    addBtn.disabled = true;
    addBtn.textContent = "Saving...";
    try {
      const ref = await addDoc(collection(db, "categories"), { name: name.trim() });
      const list = document.getElementById("categories-list");
      if (!list) {
        window.location.reload();
        return;
      }
      const item = document.createElement("div");
      item.className = "admin-category-item";
      const nameSpan = document.createElement("span");
      nameSpan.textContent = name.trim();
      const delBtn = document.createElement("button");
      delBtn.className = "admin-btn-sm admin-btn-sm--danger";
      delBtn.setAttribute("data-delete-category", ref.id);
      delBtn.textContent = "Delete";
      item.appendChild(nameSpan);
      item.appendChild(delBtn);
      item.querySelector("[data-delete-category]")?.addEventListener("click", async () => {
        const name = item.querySelector("span")?.textContent?.trim() || "this category";
        if (!confirm(`Delete category "${name}"?`)) return;
        (delBtn as HTMLButtonElement).disabled = true;
        try {
          await deleteDoc(doc(db, "categories", ref.id));
          item.remove();
        } catch (e) {
          console.error("Failed to delete:", e);
          alert("Failed to delete.");
          (delBtn as HTMLButtonElement).disabled = false;
        }
      });
      list.appendChild(item);
      const empty = list
        .closest(".admin-main")
        ?.querySelector(".admin-empty") as HTMLElement | null;
      if (empty) empty.hidden = true;
      addBtn.disabled = false;
      addBtn.textContent = "+ Add category";
    } catch (e) {
      console.error("Failed to add category:", e);
      alert("Failed to add.");
      addBtn.disabled = false;
      addBtn.textContent = "+ Add category";
    }
  });
</script>

<style is:global>
  .admin-category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .admin-category-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.88rem;
    background: var(--color-surface-warm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }
</style>
