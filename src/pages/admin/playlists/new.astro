---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="Add playlist — Admin — Ubuhanga" heading="Add playlist">
  <form id="playlist-form" class="admin-form">
    <label class="admin-field">
      <span class="admin-field__label">Title</span>
      <input class="admin-field__input" name="title" required />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Description</span>
      <textarea class="admin-field__textarea" name="description" rows="3"></textarea>
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Thumbnail URL</span>
      <input class="admin-field__input" name="thumbnail" />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Slug</span>
      <input
        class="admin-field__input"
        name="slug"
        placeholder="Auto-generated from title if empty"
      />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Tags (comma-separated)</span>
      <input class="admin-field__input" name="tags" placeholder="e.g. Docker, DevOps" />
    </label>
    <div class="admin-form__actions">
      <button type="submit" class="admin-btn admin-btn--primary">Create</button>
      <a href="/admin/playlists" class="admin-btn">Cancel</a>
    </div>
    <p class="admin-form__error" id="form-error" hidden></p>
  </form>
</AdminLayout>

<script>
  import { getFirebaseDB, getFirebaseAuth } from "@/lib/firebase-client";
  import { slugify, parseTags } from "@/lib/helpers";
  import { onAuthStateChanged } from "firebase/auth";
  import { collection, addDoc, query, where, getDocs } from "firebase/firestore";

  const auth = getFirebaseAuth();
  const db = getFirebaseDB();

  onAuthStateChanged(auth, (user) => {
    if (!user) {
      window.location.href = "/admin";
      return;
    }
  });

  document.getElementById("playlist-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const errEl = document.getElementById("form-error")!;
    errEl.hidden = true;
    const fd = new FormData(e.target as HTMLFormElement);
    const data: Record<string, unknown> = {};
    fd.forEach((val, key) => {
      data[key] = val;
    });

    if ((data.title as string).length > 150) {
      errEl.textContent = "Title must be 150 characters or fewer.";
      errEl.hidden = false;
      return;
    }
    if ((data.description as string).length > 2000) {
      errEl.textContent = "Description must be 2000 characters or fewer.";
      errEl.hidden = false;
      return;
    }
    if (!data.slug) {
      data.slug = slugify(data.title as string);
    }
    if ((data.slug as string).length > 100) {
      errEl.textContent = "Slug must be 100 characters or fewer.";
      errEl.hidden = false;
      return;
    }
    if ((data.thumbnail as string) && (data.thumbnail as string).length > 500) {
      errEl.textContent = "Thumbnail URL must be 500 characters or fewer.";
      errEl.hidden = false;
      return;
    }
    const tags: string[] = data.tags ? parseTags(data.tags as string) : [];
    if (tags.length > 10) {
      errEl.textContent = "Maximum 10 tags allowed.";
      errEl.hidden = false;
      return;
    }
    for (const tag of tags) {
      if (tag.length > 50) {
        errEl.textContent = "Each tag must be 50 characters or fewer.";
        errEl.hidden = false;
        return;
      }
    }
    data.tags = tags;

    const slug = (data.slug as string) || slugify(data.title as string);
    data.slug = slug;
    const slugQuery = query(collection(db, "playlists"), where("slug", "==", slug));
    const slugSnap = await getDocs(slugQuery);
    if (!slugSnap.empty) {
      errEl.textContent = "A playlist with this slug already exists.";
      errEl.hidden = false;
      return;
    }

    const submitBtn = document.querySelector('#playlist-form button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = "Saving...";
    try {
      await addDoc(collection(db, "playlists"), data);
      window.location.href = "/admin/playlists";
    } catch (err) {
      errEl.textContent = err instanceof Error ? err.message : "Failed to save.";
      errEl.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = "Create";
    }
  });
</script>
