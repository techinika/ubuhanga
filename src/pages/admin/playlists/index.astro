---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getPaginatedPlaylists } from "@/lib/firestore";

const page = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
const { items: playlists, pageInfo } = await getPaginatedPlaylists(page);
---

<AdminLayout title="Playlists — Admin — Ubuhanga" heading="Playlists">
  <div class="admin-bar">
    <p class="admin-bar__title">Playlists ({pageInfo.total})</p>
    <a href="/admin/playlists/new" class="admin-btn admin-btn--primary">+ Add playlist</a>
  </div>

  {playlists.length === 0 ? (
    <p class="admin-empty">No playlists yet.</p>
  ) : (
    <>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Videos</th>
              <th>Tags</th>
              <th class="admin-table__cell-actions">Actions</th>
            </tr>
          </thead>
          <tbody id="playlists-tbody">
            {playlists.map((p) => (
              <tr>
                <td class="admin-table__cell-title">{p.title}</td>
                <td>{p.videoCount ?? 0}</td>
                <td>{(p.tags || []).join(", ")}</td>
                <td class="admin-table__cell-actions">
                  <a href={`/admin/playlists/${p.id}`} class="admin-btn-sm">Edit</a>
                  <button class="admin-btn-sm admin-btn-sm--danger" data-delete-playlist={p.id}>Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {pageInfo.totalPages > 1 && (
        <div class="admin-pagination">
          {pageInfo.hasPrev && (
            <a href={`/admin/playlists?page=${page - 1}`} class="admin-btn-sm">&larr; Previous</a>
          )}
          <span class="admin-pagination__info">Page {pageInfo.page} of {pageInfo.totalPages}</span>
          {pageInfo.hasNext && (
            <a href={`/admin/playlists?page=${page + 1}`} class="admin-btn-sm">Next &rarr;</a>
          )}
        </div>
      )}
    </>
  )}
</AdminLayout>

<script>
  import { getFirebaseDB, getFirebaseAuth } from "@/lib/firebase-client";
  import { onAuthStateChanged } from "firebase/auth";
  import { doc, deleteDoc } from "firebase/firestore";

  const auth = getFirebaseAuth();
  const db = getFirebaseDB();

  onAuthStateChanged(auth, (user) => {
    if (!user) { window.location.href = "/admin"; return; }
    initPage();
  });

  function initPage() {
    document.querySelectorAll("[data-delete-playlist]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-delete-playlist")!;
        const title = btn.closest("tr")?.querySelector(".admin-table__cell-title")?.textContent?.trim() || "this playlist";
        if (!confirm(`Delete "${title}"?`)) return;
        try {
          await deleteDoc(doc(db, "playlists", id));
          btn.closest("tr")?.remove();
        } catch (e) {
          console.error("Failed to delete:", e);
          alert("Failed to delete.");
        }
      });
    });
  }
</script>
