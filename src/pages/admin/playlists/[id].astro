---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getDB } from "@/lib/firestore";

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/playlists");

const db = getDB();
const snap = await db.collection("playlists").doc(id).get();

if (!snap.exists) {
  return Astro.redirect("/admin/playlists");
}

const data = snap.data()!;
---

<AdminLayout title="Edit playlist — Admin — Ubuhanga" heading="Edit playlist">
  <form id="playlist-form" class="admin-form">
    <label class="admin-field">
      <span class="admin-field__label">Title</span>
      <input class="admin-field__input" name="title" value={data.title ?? ""} required />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Description</span>
      <textarea class="admin-field__textarea" name="description" rows="3"
        >{data.description ?? ""}</textarea
      >
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Thumbnail URL</span>
      <input class="admin-field__input" name="thumbnail" id="thumbnail-input" value={data.thumbnail ?? ""} />
      <img id="thumbnail-preview" class="admin-thumb-preview" hidden alt="Thumbnail preview" />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Slug</span>
      <input class="admin-field__input" name="slug" value={data.slug ?? ""} />
    </label>
    <label class="admin-field">
      <span class="admin-field__label">Tags (comma-separated)</span>
      <input
        class="admin-field__input"
        name="tags"
        value={(Array.isArray(data.tags) ? data.tags : []).join(", ")}
      />
    </label>
    <div class="admin-form__actions">
      <button type="submit" class="admin-btn admin-btn--primary">Update</button>
      <a href="/admin/playlists" class="admin-btn">Cancel</a>
    </div>
    <p class="admin-form__error" id="form-error" hidden></p>
  </form>
</AdminLayout>

<script>
  import { getFirebaseDB, getFirebaseAuth } from "@/lib/firebase-client";
  import { slugify, parseTags } from "@/lib/helpers";
  import { onAuthStateChanged } from "firebase/auth";
  import { doc, updateDoc, collection, query, where, getDocs } from "firebase/firestore";

  const auth = getFirebaseAuth();
  const db = getFirebaseDB();

  onAuthStateChanged(auth, (user) => {
    if (!user) {
      window.location.href = "/admin";
      return;
    }
  });

  const playlistId = window.location.pathname.split("/").pop()!;

  const thumbInput = document.getElementById("thumbnail-input") as HTMLInputElement;
  const thumbPreview = document.getElementById("thumbnail-preview") as HTMLImageElement;
  if (thumbInput?.value) {
    thumbPreview.src = thumbInput.value;
    thumbPreview.hidden = false;
  }
  thumbInput?.addEventListener("input", () => {
    if (thumbInput.value) {
      thumbPreview.src = thumbInput.value;
      thumbPreview.hidden = false;
    } else {
      thumbPreview.hidden = true;
    }
  });

  document.getElementById("playlist-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const errEl = document.getElementById("form-error")!;
    errEl.hidden = true;
    const fd = new FormData(e.target as HTMLFormElement);
    const formData: Record<string, unknown> = {};
    fd.forEach((val, key) => {
      formData[key] = val;
    });

    if ((formData.title as string).length > 150) {
      errEl.textContent = "Title must be 150 characters or fewer.";
      errEl.hidden = false;
      return;
    }
    if ((formData.description as string).length > 2000) {
      errEl.textContent = "Description must be 2000 characters or fewer.";
      errEl.hidden = false;
      return;
    }
    if (!formData.slug) {
      formData.slug = slugify(formData.title as string);
    }
    if ((formData.slug as string).length > 100) {
      errEl.textContent = "Slug must be 100 characters or fewer.";
      errEl.hidden = false;
      return;
    }
    if ((formData.thumbnail as string) && (formData.thumbnail as string).length > 500) {
      errEl.textContent = "Thumbnail URL must be 500 characters or fewer.";
      errEl.hidden = false;
      return;
    }
    const tags: string[] = formData.tags ? parseTags(formData.tags as string) : [];
    if (tags.length > 10) {
      errEl.textContent = "Maximum 10 tags allowed.";
      errEl.hidden = false;
      return;
    }
    for (const tag of tags) {
      if (tag.length > 50) {
        errEl.textContent = "Each tag must be 50 characters or fewer.";
        errEl.hidden = false;
        return;
      }
    }
    formData.tags = tags;

    const slug = (formData.slug as string) || slugify(formData.title as string);
    formData.slug = slug;
    const slugQuery = query(
      collection(db, "playlists"),
      where("slug", "==", slug),
      where("__name__", "!=", playlistId)
    );
    const slugSnap = await getDocs(slugQuery);
    if (!slugSnap.empty) {
      errEl.textContent = "A playlist with this slug already exists.";
      errEl.hidden = false;
      return;
    }

    const submitBtn = document.querySelector('#playlist-form button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = "Saving...";
    try {
      await updateDoc(doc(db, "playlists", playlistId), formData);
      window.location.href = "/admin/playlists";
    } catch (err) {
      errEl.textContent = err instanceof Error ? err.message : "Failed to save.";
      errEl.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = "Update";
    }
  });
</script>
